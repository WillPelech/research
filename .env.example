# Required: where the weekly digest should go.
# Accepts multiple addresses separated by commas or semicolons.
DIGEST_TO_EMAIL=you@example.com

# Optional: additional recipients, merged with DIGEST_TO_EMAIL and de-duped.
# DIGEST_EXTRA_EMAILS=teammate@example.com,someone-else@example.com

# From address (must be verified in Resend, or allowed by your SMTP provider)
DIGEST_FROM_EMAIL=Research Digest <onboarding@resend.dev>

# Which sender to use: auto (default; Resend if RESEND_API_KEY is set), resend, or smtp.
# Set this to smtp to force SMTP even when a Resend key is still configured.
# DIGEST_EMAIL_PROVIDER=auto

# --- Email via Resend (recommended) ---
RESEND_API_KEY=re_xxxxxxxx

# --- Or email via SMTP (omit RESEND_API_KEY to use this) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true

# Optional
# DRY_RUN=0
